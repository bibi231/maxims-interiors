# ============================================================
# MAXIMS INTERIORS — API ENVIRONMENT
# These values are set as Environment Variables in Vercel
# (Project → Settings → Environment Variables). For local dev,
# copy to server/.env. NEVER commit real secrets.
# ============================================================

# Core
NODE_ENV=production
CLIENT_ORIGIN=https://maximsinterior.com.ng,https://www.maximsinterior.com.ng,http://localhost:5173
APP_URL=https://maximsinterior.com.ng
API_URL=https://maximsinterior.com.ng

# Database — MariaDB on the DirectAdmin server (MySQL Management in DA).
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# On DA the DB and user are prefixed with the account name, e.g. gadzamac_maxims.
DATABASE_URL=mysql://DBUSER:DBPASS@localhost:3306/DBNAME
# Only for the one-off `npm run db:copy-from-mongo` (the app no longer uses MongoDB)
MONGODB_URI=
# Optional: pool size (default 5)
DB_POOL_SIZE=5

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Staff accounts are created by `npm run staff` WITHOUT passwords; each mailbox
# gets a 72-hour set-up link by email. There is no default password.

# Uploads — Cloudinary (free tier) so images persist on serverless
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
PAYMENT_PROVIDER=squad
SQUAD_SECRET_KEY=
SQUAD_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# Email — Whogohost SMTP (domain mailbox) for sending; alerts go to the Gmail
EMAIL_PROVIDER=smtp
SMTP_HOST=mail.maximsinterior.com.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@maximsinterior.com.ng
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=Maxims Interior <info@maximsinterior.com.ng>
# Staff alerts for every new order / quote / contact / booking / bulk request.
# Comma-separated. Falls back to NOTIFICATION_EMAIL, then to
# info@, support@ and christinegadzama@maximsinterior.com.ng.
BUSINESS_NOTIFY_EMAILS=info@maximsinterior.com.ng,support@maximsinterior.com.ng,christinegadzama@maximsinterior.com.ng
NOTIFICATION_EMAIL=
# Where customer replies to confirmation emails go
MAIL_REPLY_TO=info@maximsinterior.com.ng

# Online payments switch. Keep false until Paystack / Squad live keys are set;
# customers submit order/quote requests instead. true = pay buttons return.
PAYMENTS_ENABLED=false

# SupportAI lead forwarding (best-effort, server-side). Leave blank to disable.
SUPPORTAI_API_KEY=
SUPPORTAI_BOT_ID=6a58aa0726d3a64c4c51611b
SUPPORTAI_API_URL=https://api.supportai.com.ng

# Mirror newsletter signups to TrueWeb so they appear in your TrueWeb admin too
TRUEWEB_NEWSLETTER_URL=https://trueweb.com.ng/api/newsletter/subscribe
